# ==============================================================================
# Class Gallery Environment Variables (Template)
# Copy this file to .env and fill in your values
# ==============================================================================

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Modern Publishable API Key (recommended by Supabase; replaces legacy anon key)
# Legacy SUPABASE_ANON_KEY is also accepted as fallback
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

SUPABASE_STORAGE_BUCKET=class-moments
PRODUCTION_DOMAIN=https://gallery.mndo.online
PORT=5500
